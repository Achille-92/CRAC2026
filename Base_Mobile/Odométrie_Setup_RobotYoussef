#include <Arduino.h>
#include <Wire.h>
#include <ESP32Encoder.h>
#include <CAN.h>

#define TX_GPIO_NUM   5
#define RX_GPIO_NUM   4

void Asserv(void *);

int tic_gauche = 0;
int tic_droit = 0;
float tour_gauche = 0;
float tour_droit = 0;
float distance_droit = 0, old_dist_droit = 0, diff_dist_droit = 0;
float distance_gauche = 0, old_dist_gauche = 0, diff_dist_gauche = 0;
float dist = 0, teta = 0, delta_x = 0, delta_y = 0, teta_act = 0, diff_teta = 0, teta_act_deg = 0, teta_deg = 0, diff_deg = 0;
float pos_act[2] = {0, 0}, pos_fin[2] = {105, 120}, erreur_droit = 0, erreur_gauche = 0, Kp = 1, Kd = 1, old_erreur_droit = 0, old_erreur_gauche = 0, cmd = 0;
int VIT_gauche = 0, VIT_droit = 0, etat = 0, i = 0, temp = 0;
int tic_Sd = 0, old_tic_droit = 0, diff_tic_droit = 0, tic_Md = 0, old_diff_tic_droit = 0, old_VIT_droit = 0, tic_Mda = 0, VIT_Ad = 0;
int tic_Sg = 0, old_tic_gauche = 0, diff_tic_gauche = 0, tic_Mg = 0, old_diff_tic_gauche = 0, old_VIT_gauche = 0, tic_Mga = 0, VIT_Ag = 0;
float kpd = 0.06, kdd = 0.5, kpg = 0.06, kdg = 0.5, kpda = 0.4, kpga = 0.4;
float err_x = 0, err_y = 0, Vg = 0, Vd = 0, VIT = 0, Acc = 0, Dec = 0, Vo = 10, Pos = 0, Te = 5, accg = 0, accd = 0, old_Vd = 0, old_Vg = 0, Adm = 0, Agm = 0, Vdm = 0, Vgm = 0;

float teta_recu = 0.0;
int etat_ESP_RPI = 0, etat_RPI = 0;

const float tic_tour_droit = 3164.0, tic_tour_gauche = 3167.7, Rayon = 11.2;
ESP32Encoder encoder;
ESP32Encoder encoder2;
TaskHandle_t Asservissement;

void setup()
{
  Serial.begin(115200);
  ESP32Encoder::useInternalWeakPullResistors = puType::up;

  // use pin 19 and 18 for the first encoder
  encoder.attachFullQuad(36, 39);
  // use pin 17 and 16 for the second encoder
  encoder2.attachFullQuad(23, 22);

  // set starting count value after attaching
  encoder.setCount(0);
  encoder2.setCount(0);

  // clear the encoder's raw count and set the tracked count to zero
  //
  Serial.println("Encoder Start = " + String((int32_t)encoder.getCount()));
  xTaskCreate(Asserv, "Asserv", 32000, NULL, 15, &Asservissement);
  temp = millis();

  CAN.setPins (RX_GPIO_NUM, TX_GPIO_NUM);

  // start the CAN bus at 500 kbps
  if (!CAN.begin(1000E3)) {
    Serial.println("Starting CAN failed!");
    while (1);
  }

}
void loop()
{
  // Lecture CAN centralisée
  int packetSize = CAN.parsePacket();
  if (packetSize) {
    uint32_t canId = CAN.packetId();

    if (canId == 0x01 && (packetSize == 4 || packetSize == 1)) {
      CAN.readBytes((uint8_t*)&etat_RPI, packetSize);
      while (CAN.available()) CAN.read(); // vider le buffer
      Serial.print("Reçu état RPi : ");
      Serial.println(etat_RPI);
    }

    else if (canId == 0x20 && packetSize == 4) {
      CAN.readBytes((uint8_t*)&pos_act[0], 4);
      Serial.print("Reçu X : ");
      Serial.println(pos_act[0]);
    }

    else if (canId == 0x21 && packetSize == 4) {
      CAN.readBytes((uint8_t*)&pos_act[1], 4);
      Serial.print("Reçu Y : ");
      Serial.println(pos_act[1]);
    }

    else if (canId == 0x22 && packetSize == 4) {
      CAN.readBytes((uint8_t*)&teta_recu, 4);
      Serial.print("Reçu Angle : ");
      Serial.println(teta_recu, 2);
      teta_act = teta_recu * PI / 180.0;
    }
  }

  switch (etat_ESP_RPI){
    case 0: 
      static bool x_ok = false, y_ok = false, angle_ok = false;

      if (pos_act[0] != 0) x_ok = true;
      if (pos_act[1] != 0) y_ok = true;
      if (teta_recu != 0) angle_ok = true;

      if (!x_ok || !y_ok || !angle_ok) {
        Serial.println("En attente des coordonnées initiales depuis la RPi...");
      }

      // Test en continu de la condition de passage à l'état 1
      if (x_ok && y_ok && angle_ok) {
        if (etat_RPI == 1) {
          Serial.println("Coordonnées reçues, passage à l'état 1 !");
          etat_ESP_RPI = 1;
          encoder.setCount(0);
          encoder2.setCount(0);
          distance_droit = distance_gauche = 0;
        } else {
          Serial.println("Coordonnées OK mais RPi pas encore prête (etat_RPI != 1)");
        }
      }
      break;
    
    
    case 1:
      if (etat_RPI == 0 || etat_RPI == 2) {
        etat_ESP_RPI = 0;
        x_ok = false, y_ok = false, angle_ok = false;
        Serial.println("Retour à l'état 0 (RPi arrêtée)");
      }

      //////////////////////////////////////////////calcule distance/tic/tour par roue
    
      old_tic_droit = tic_droit;
      old_tic_gauche = tic_gauche;
      tic_droit = encoder2.getCount();
      tic_gauche = encoder.getCount();
      tour_droit = (float)tic_droit / tic_tour_droit;
      tour_gauche = (float)tic_gauche / tic_tour_gauche;
      old_dist_droit = distance_droit;
      old_dist_gauche = distance_gauche;
      distance_droit = tour_droit * 40.0 * PI;
      distance_gauche = tour_gauche * 40.0 * PI;
      diff_dist_droit = distance_droit - old_dist_droit;
      diff_dist_gauche = distance_gauche - old_dist_gauche;

      err_x = cos(teta_act) * (pos_fin[0] - pos_act[0]) + sin(teta_act) * (pos_fin[1] - pos_act[1]);
      err_y = -sin(teta_act) * (pos_fin[0] - pos_act[0]) + cos(teta_act) * (pos_fin[1] - pos_act[1]);

      /////////////////////////////////////////////////////////////// test asserv diff moteur gauche moteur droit ne pas utiliser

      /////////////////////////////////////////////// calcule angle + coordonnées

      delta_x = pos_fin[0] - pos_act[0];
      delta_y = pos_fin[1] - pos_act[1];
      teta = atan2(delta_y, delta_x);
      diff_teta = teta_act - teta;
      teta_act = (teta_recu*PI/180.0) + (distance_droit - distance_gauche) / (20 * Rayon);
      teta_act_deg = (teta_act * 180.0) / PI;
      teta_deg = (teta * 180.0) / PI;
      diff_deg = (diff_teta * 180.0) / PI;

      pos_act[0] = pos_act[0] + (cos(teta_act) * ((diff_dist_droit + diff_dist_gauche) / 2));
      pos_act[1] = pos_act[1] + (sin(teta_act) * ((diff_dist_gauche + diff_dist_droit) / 2));
      dist = sqrt(((pos_fin[0] - pos_act[0]) * (pos_fin[0] - pos_act[0])) + ((pos_fin[1] - pos_act[1]) * (pos_fin[1] - pos_act[1])));

      ////////////////////////////////////////////////////// test asserv chaque moteur par rapport à un ordre général

      tic_Md = ((dist * tic_tour_droit) / (40 * PI));
      tic_Mg = ((dist * tic_tour_gauche) / (40 * PI));
      tic_Mga = (((diff_teta * 110)) * tic_tour_gauche) / (40.0 * PI);
      tic_Mda = (((diff_teta * 110)) * tic_tour_droit) / (40.0 * PI);

      tic_Sd = old_tic_droit - tic_droit; // tic parcouru par la roue droite
      diff_tic_droit = tic_Md - tic_Sd;
      // différence entre tic demander et tic parcouru
      old_diff_tic_droit = diff_tic_droit;
      old_VIT_droit = VIT_droit;
      VIT_droit = cos(diff_teta) * (kpd * diff_tic_droit + kdd * (diff_tic_droit - old_diff_tic_droit)); // asserv suivant la différence de tic
      VIT_Ad = -kpda * (tic_Mda - tic_Sd);

      tic_Sg = old_tic_gauche - tic_gauche; // tic parcouru par la roue droite
      diff_tic_gauche = tic_Mg - tic_Sg;    // différence entre tic demander et tic parcouru
      old_diff_tic_gauche = diff_tic_gauche;
      old_VIT_gauche = VIT_gauche;
      VIT_gauche = cos(diff_teta) * (kpg * diff_tic_gauche + kdg * (diff_tic_gauche - old_diff_tic_gauche));
      // asserv suivant la différence de tic
      VIT_Ag = kpga * (tic_Mga - tic_Sg);

      Serial.printf("X=%.1f Y=%.1f Angle=%.1f \n",pos_act[0],pos_act[1],teta_act_deg);
      float x = pos_act[0];
      float y = pos_act[1];
      float teta = teta_act_deg;


      static unsigned long lastSend = 0;
      if (millis() - lastSend > 100) {  // toutes les 100 ms
        lastSend = millis();

        CAN.beginPacket(0x10);
        CAN.write((uint8_t*)&x, sizeof(float));   // 4 octets
        CAN.endPacket();

        CAN.beginPacket(0x11);
        CAN.write((uint8_t*)&y, sizeof(float));   // 4 octets
        CAN.endPacket();

        CAN.beginPacket(0x12);
        CAN.write((uint8_t*)&teta, sizeof(float)); // 4 octets
        CAN.endPacket();
      }
      break;
      
  }
  

}

void Asserv(void *)

{

  while (1)
  {
    vTaskDelay(pdMS_TO_TICKS(Te));
  }
}
