float err_x = 0, err_y = 0, Vg = 0, Vd = 0, VIT = 0, Acc = 0, Dec = 0, Vo = 10, Pos = 0, Te = 5, accg = 0, accd = 0, old_Vd = 0, old_Vg = 0, Adm = 0, Agm = 0, Vdm = 0, Vgm = 0;

const float tic_tour_droit = 3164.0, tic_tour_gauche = 3167.7, Rayon = 11.2;
ESP32Encoder encoder;
ESP32Encoder encoder2;
TaskHandle_t Asservissement;

void setup()
{
  Serial.begin(115200);
  ESP32Encoder::useInternalWeakPullResistors = puType::up;

  // use pin 19 and 18 for the first encoder
  encoder.attachFullQuad(36, 39);
  // use pin 17 and 16 for the second encoder
  encoder2.attachFullQuad(23, 22);

  // set starting count value after attaching
  encoder.setCount(0);
  encoder2.setCount(0);

  // clear the encoder's raw count and set the tracked count to zero
  //
  Serial.println("Encoder Start = " + String((int32_t)encoder.getCount()));
  xTaskCreate(Asserv, "Asserv", 32000, NULL, 15, &Asservissement);
  temp = millis();
}
void loop()
{

  //////////////////////////////////////////////calcule distance/tic/tour par roue

  old_tic_droit = tic_droit;
  old_tic_gauche = tic_gauche;
  tic_droit = encoder2.getCount();
  tic_gauche = encoder.getCount();
  tour_droit = (float)tic_droit / tic_tour_droit;
  tour_gauche = (float)tic_gauche / tic_tour_gauche;
  old_dist_droit = distance_droit;
  old_dist_gauche = distance_gauche;
  distance_droit = tour_droit * 40.0 * PI;
  distance_gauche = tour_gauche * 40.0 * PI;
  diff_dist_droit = distance_droit - old_dist_droit;
  diff_dist_gauche = distance_gauche - old_dist_gauche;

  err_x = cos(teta_act) * (pos_fin[0] - pos_act[0]) + sin(teta_act) * (pos_fin[1] - pos_act[1]);
  err_y = -sin(teta_act) * (pos_fin[0] - pos_act[0]) + cos(teta_act) * (pos_fin[1] - pos_act[1]);

  /////////////////////////////////////////////////////////////// test asserv diff moteur gauche moteur droit ne pas utiliser

  /////////////////////////////////////////////// calcule angle + coordonnées

  delta_x = pos_fin[0] - pos_act[0];
  delta_y = pos_fin[1] - pos_act[1];
  teta = atan2(delta_y, delta_x);
  diff_teta = teta_act - teta;
  teta_act = (distance_droit - distance_gauche) / (20 * Rayon);
  teta_act_deg = (teta_act * 180.0) / PI;
  teta_deg = (teta * 180.0) / PI;
  diff_deg = (diff_teta * 180.0) / PI;

  pos_act[0] = pos_act[0] + (cos(teta_act) * ((diff_dist_droit + diff_dist_gauche) / 2));
  pos_act[1] = pos_act[1] + (sin(teta_act) * ((diff_dist_gauche + diff_dist_droit) / 2));
  dist = sqrt(((pos_fin[0] - pos_act[0]) * (pos_fin[0] - pos_act[0])) + ((pos_fin[1] - pos_act[1]) * (pos_fin[1] - pos_act[1])));

  ////////////////////////////////////////////////////// test asserv chaque moteur par rapport à un ordre général

  tic_Md = ((dist * tic_tour_droit) / (40 * PI));
  tic_Mg = ((dist * tic_tour_gauche) / (40 * PI));
  tic_Mga = (((diff_teta * 110)) * tic_tour_gauche) / (40.0 * PI);
  tic_Mda = (((diff_teta * 110)) * tic_tour_droit) / (40.0 * PI);

  tic_Sd = old_tic_droit - tic_droit; // tic parcouru par la roue droite
  diff_tic_droit = tic_Md - tic_Sd;
  // différence entre tic demander et tic parcouru
  old_diff_tic_droit = diff_tic_droit;
  old_VIT_droit = VIT_droit;
  VIT_droit = cos(diff_teta) * (kpd * diff_tic_droit + kdd * (diff_tic_droit - old_diff_tic_droit)); // asserv suivant la différence de tic
  VIT_Ad = -kpda * (tic_Mda - tic_Sd);

  tic_Sg = old_tic_gauche - tic_gauche; // tic parcouru par la roue droite
  diff_tic_gauche = tic_Mg - tic_Sg;    // différence entre tic demander et tic parcouru
  old_diff_tic_gauche = diff_tic_gauche;
  old_VIT_gauche = VIT_gauche;
  VIT_gauche = cos(diff_teta) * (kpg * diff_tic_gauche + kdg * (diff_tic_gauche - old_diff_tic_gauche));
  // asserv suivant la différence de tic
  VIT_Ag = kpga * (tic_Mga - tic_Sg);

  Serial.printf("X=%.1f Y=%.1f teta=%.1f \n", pos_act[0], pos_act[1], teta_act_deg);

}

