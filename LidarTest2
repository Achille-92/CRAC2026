from rplidar import RPLidar

PORT_NAME = '/dev/ttyUSB0'

lidar = RPLidar(PORT_NAME)

try:
    for i, (new_scan, quality, angle, distance) in enumerate(lidar.iter_measures()):
        print(i, quality, angle, distance)
        if i > 50:
            break
finally:
    lidar.stop()
    lidar.disconnect()
