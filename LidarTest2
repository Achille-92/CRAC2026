################## Librairies ##########################################
import matplotlib.pyplot as plt
from rplidar import RPLidar           # même si le pip est "rplidar_roboticia"
import numpy as np
########################################################################

# Port série du lidar (vérifie avec dmesg | grep tty)
PORT_NAME = '/dev/ttyUSB0'

angles = []                                                             
distances = []                                                          

################## Fonction run() ######################################
def run(scan_type="normal"):
    lidar = RPLidar(PORT_NAME)
    global angles, distances

    fig, ax = plt.subplots(subplot_kw={'projection': 'polar'})          
    ax.set_ylim(0, 6000)  # portée max du lidar en mm                   
    ax.set_title(f"RPLIDAR A2 - Scan en temps réel ({scan_type})")      
    points, = ax.plot([], [], 'bo', markersize=2)                       
    
    try:
        for scan in lidar.iter_scans(scan_type=scan_type):
            # On réinitialise à chaque tour (sinon les listes deviennent infinies)
            angles = []
            distances = []

            for (_, angle, distance) in scan:
                angles.append(np.radians(angle))
                distances.append(distance)

            points.set_data(angles, distances)
            plt.pause(0.01)
    except KeyboardInterrupt:
        print("Arrêt demandé par l'utilisateur")                        
    finally:
        lidar.stop()
        lidar.disconnect()

########################################################################

################## Lancement du programme principal ####################
if __name__ == '__main__':
    try:
        run(scan_type="normal")          # tentative en mode normal
    except Exception as e:
        print("Erreur en mode normal :", e)
        print("⚠️ Passage en mode express...")
        run(scan_type="express")         # fallback en mode express
########################################################################
