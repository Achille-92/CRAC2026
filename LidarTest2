################## Librairies ##########################################
import matplotlib.pyplot as plt
from rplidar import RPLidar
import numpy as np
########################################################################

PORT_NAME = '/dev/ttyUSB0'

def run():
    lidar = RPLidar(PORT_NAME, baudrate=115200)

    fig, ax = plt.subplots(subplot_kw={'projection': 'polar'})
    ax.set_ylim(0, 6000)
    ax.set_title("RPLIDAR A2 - Mesures en temps réel")
    points, = ax.plot([], [], 'bo', markersize=2)

    angles = []
    distances = []

    try:
        for i, (new_scan, quality, angle, distance) in enumerate(lidar.iter_measures()):
            if quality > 0:  # filtrer les mauvaises mesures
                angles.append(np.radians(angle))
                distances.append(distance)

            # À chaque "new_scan=True", on a un nouveau tour → on rafraîchit l'affichage
            if new_scan:
                points.set_data(angles, distances)
                plt.pause(0.01)
                angles = []
                distances = []

    except KeyboardInterrupt:
        print("Arrêt demandé par l'utilisateur")
    finally:
        lidar.stop()
        lidar.disconnect()

########################################################################
if __name__ == '__main__':
    run()
########################################################################
