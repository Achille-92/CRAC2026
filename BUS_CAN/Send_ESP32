#include <Arduino.h>
#include "driver/twai.h"

void setup() {
  Serial.begin(115200);

  // Configuration CAN (TWAI)
  twai_general_config_t g_config = TWAI_GENERAL_CONFIG_DEFAULT(GPIO_NUM_21, GPIO_NUM_22, TWAI_MODE_NORMAL);
  twai_timing_config_t t_config = TWAI_TIMING_CONFIG_500KBITS(); // Vitesse 500 kbit/s
  twai_filter_config_t f_config = TWAI_FILTER_CONFIG_ACCEPT_ALL();

  if (twai_driver_install(&g_config, &t_config, &f_config) == ESP_OK) {
    Serial.println("Driver CAN installé");
  } else {
    Serial.println("Erreur installation driver CAN");
    return;
  }

  if (twai_start() == ESP_OK) {
    Serial.println("CAN démarré");
  } else {
    Serial.println("Erreur démarrage CAN");
    return;
  }
}

void loop() {
  twai_message_t message;
  // Attente d’un message pendant 1s
  if (twai_receive(&message, pdMS_TO_TICKS(1000)) == ESP_OK) {
    Serial.print("Message reçu. ID: 0x");
    Serial.print(message.identifier, HEX);
    Serial.print(" Data: ");
    for (int i = 0; i < message.data_length_code; i++) {
      Serial.write(message.data[i]); // Affiche directement en ASCII
      Serial.print(" ");
    }
    Serial.println();
  }
}

