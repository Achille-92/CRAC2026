  tic_Md = ((dist * tic_tour_droit) / (40 * PI));
  tic_Mg = ((dist * tic_tour_gauche) / (40 * PI));
  tic_Mga = (((diff_teta * 110)) * tic_tour_gauche) / (40.0 * PI);
  tic_Mda = (((diff_teta * 110)) * tic_tour_droit) / (40.0 * PI);

  tic_Sd = old_tic_droit - tic_droit; // tic parcouru par la roue droite
  diff_tic_droit = tic_Md - tic_Sd;
