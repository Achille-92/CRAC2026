  old_diff_tic_droit = diff_tic_droit;
  old_VIT_droit = VIT_droit;
  VIT_droit = cos(diff_teta) * (kpd * diff_tic_droit + kdd * (diff_tic_droit - old_diff_tic_droit)); // asserv suivant la différence de tic
  VIT_Ad = -kpda * (tic_Mda - tic_Sd);

  tic_Sg = old_tic_gauche - tic_gauche; // tic parcouru par la roue droite
  diff_tic_gauche = tic_Mg - tic_Sg;    // différence entre tic demander et tic parcouru
  old_diff_tic_gauche = diff_tic_gauche;
  old_VIT_gauche = VIT_gauche;
  VIT_gauche = cos(diff_teta) * (kpg * diff_tic_gauche + kdg * (diff_tic_gauche - old_diff_tic_gauche));
  // asserv suivant la différence de tic
  VIT_Ag = kpga * (tic_Mga - tic_Sg);
  //////////////////////////////////////////////////////// test moteur/encodeur

  /*
