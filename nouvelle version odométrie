  */
  ////////////////////////////////////Saturation + mise à jour moteur

  if (VIT_droit > 100)
    VIT_droit = 100;
  if (VIT_gauche > 100)
    VIT_gauche = 100;
  if (VIT_droit < -100)
    VIT_droit = -100;
  if (VIT_gauche < -100)
    VIT_gauche = -100;

  if (VIT_Ad > 100)
    VIT_Ad = 100;
  if (VIT_Ag > 100)
    VIT_Ag = 100;
  if (VIT_Ad < -100)
    VIT_Ad = -100;
  if (VIT_Ag < -100)
    VIT_Ag = -100;

  md.setM2Speed(VIT_droit + VIT_Ad);

  md.setM1Speed(VIT_gauche + VIT_Ag);

  if (VIT_Ad == 0 && VIT_Ag == 0 && VIT_droit == 0 && VIT_gauche == 0)
    md.setBrakes(400, 400);

  Serial.printf("X=%.1f Y=%.1f teta=%.1f VIT_gauche=%d VIT_droite=%d tic_Mg=%d dist=%.1f old_vit%d diff_tic_g=%d tic_g=%d teta=%.1f dif_te=%.0f VIT_Ag=%d\n", pos_act[0], pos_act[1], teta_act_deg, VIT_gauche, VIT_droit, tic_Mg, dist, old_VIT_gauche, diff_tic_gauche, tic_gauche, teta_act_deg, diff_deg, VIT_Ag);

  // Serial.printf("gauche%d droit%d ", tic_gauche, tic_droit);
  if (i >= 5)
  {
    // Bt.printf("I=%d\n", i);
    Bt.printf("%.2f %.2f %f %f\n", Vg, Vd, accg, accd);
    // Bt.printf("Vg=%.2f Vd=%.2f VIT=%.1f Pos=%.1f dg=%.1f dd=%.1f accg=%f accd=%f distd=%f\n", Vgm, Vdm, VIT, Pos, diff_dist_gauche, diff_dist_droit, Agm, Adm,distance_droit);
    i = 0;
  }
}

