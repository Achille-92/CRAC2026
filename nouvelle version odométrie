  distance_gauche = tour_gauche * 40.0 * PI;
  diff_dist_droit = distance_droit - old_dist_droit;
  diff_dist_gauche = distance_gauche - old_dist_gauche;

  err_x = cos(teta_act) * (pos_fin[0] - pos_act[0]) + sin(teta_act) * (pos_fin[1] - pos_act[1]);
