import matplotlib.pyplot as plt
from rplidar import RPLidar
import numpy as np

PORT_NAME = '/dev/ttyUSB0'
BAUDRATE = 256000

def run():
    lidar = RPLidar(PORT_NAME, baudrate=BAUDRATE)
    print("INFO :", lidar.get_info())
    print("HEALTH :", lidar.get_health())

    fig, ax = plt.subplots(subplot_kw={'projection': 'polar'})
    ax.set_ylim(0, 6000)
    ax.set_title("RPLIDAR A2M12 - Scan en temps réel")
    points, = ax.plot([], [], 'bo', markersize=2)

    angles, distances = [], []
    refresh_rate = 50  # on affiche toutes les 50 mesures

    try:
        for i, (new_scan, quality, angle, distance) in enumerate(lidar.iter_measures()):
            if distance > 0 and quality > 0:  # filtre de base
                angles.append(np.radians(angle))
                distances.append(distance)

            if i % refresh_rate == 0:  # on ne rafraîchit pas à chaque mesure
                points.set_data(angles, distances)
                plt.pause(0.01)

            if new_scan:  # nouveau tour → reset
                angles, distances = [], []

    except KeyboardInterrupt:
        print("Arrêt demandé par l'utilisateur")

    finally:
        print("Arrêt du Lidar...")
        lidar.stop()
        lidar.stop_motor()
        lidar.disconnect()
        plt.close()

if __name__ == '__main__':
    run()
