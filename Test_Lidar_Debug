import matplotlib.pyplot as plt
from rplidar import RPLidar
import numpy as np
import signal
import sys

PORT_NAME = '/dev/ttyUSB1'
BAUDRATE = 256000

angles = []
distances = []

# pour gérer Ctrl+C
def signal_handler(sig, frame):
    print("\nInterruption reçue, arrêt du Lidar...")
    global lidar
    try:
        lidar.stop()
        lidar.stop_motor()
        lidar.disconnect()
    except:
        pass
    plt.close('all')
    sys.exit(0)

signal.signal(signal.SIGINT, signal_handler)

# objet global lidar
lidar = RPLidar(PORT_NAME, baudrate=BAUDRATE)
lidar.start_motor()

plt.ion()
fig, ax = plt.subplots(subplot_kw={'projection':'polar'})
ax.set_ylim(0,6000)
ax.set_title("RPLIDAR A2M12 - Scan en temps réel")
points, = ax.plot([],[], 'bo', markersize=2)

refresh_rate = 20
i = 0

try:
    for new_scan, quality, angle, distance in lidar.iter_measures(scan_type='express', max_buf_meas=500):
        if distance is not None and quality is not None and distance > 0 and quality > 0:
            angles.append(np.radians(angle))
            distances.append(distance)
        i += 1
        if i % refresh_rate == 0:
            points.set_data(angles, distances)
            plt.pause(0.01)
except Exception as e:
    print("Erreur RPLidar :", e)
finally:
    print("Arrêt du Lidar...")
    lidar.stop()
    lidar.stop_motor()
    lidar.disconnect()
    plt.close()
