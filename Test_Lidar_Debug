from rplidar import RPLidar

PORT_NAME = '/dev/ttyUSB0'
BAUDRATE = 256000

lidar = None
try:
    lidar = RPLidar(PORT_NAME, baudrate=BAUDRATE)
    print("INFO:", lidar.get_info())
    print("HEALTH:", lidar.get_health())

    lidar.start_motor()

    # itération en mode express
    for scan in lidar.iter_scans(scan_type='express', max_buf_meas=500):
        for quality, angle, distance in scan:
            print(f"Angle: {angle:.1f}°, Dist: {distance:.1f} mm, Qualité: {quality}")

except Exception as e:
    print("Erreur:", type(e).__name__, e)

finally:
    if lidar:
        lidar.stop()
        lidar.stop_motor()
        lidar.disconnect()
