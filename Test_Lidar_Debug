from rplidar import RPLidar

PORT = '/dev/ttyUSB0'

def run():
    lidar = RPLidar(PORT, baudrate=115200)

    try:
        # On force le mode express
        for scan in lidar.iter_scans(scan_type='express'):
            print("--- Nouveau tour ---")
            for quality, angle, distance in scan:
                print(f"Angle: {angle:.2f}°, Dist: {distance:.1f} mm, Qualité: {quality}")
    except Exception as e:
        print("ERREUR:", type(e).__name__, e)
    finally:
        lidar.stop()
        lidar.disconnect()

if __name__ == "__main__":
    run()
