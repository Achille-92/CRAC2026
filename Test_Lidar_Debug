from rplidar import RPLidar
import time

PORT = "/dev/ttyUSB0"
lidar = RPLidar(PORT, baudrate=256000)

try:
    print("INFO:", lidar.get_info())
    print("HEALTH:", lidar.get_health())
    lidar.start_motor()

    for i, scan in enumerate(lidar.iter_scans(max_buf_meas=500)):
        print(f"Scan {i}: {len(scan)} points")
        if i >= 5:  # on arrête après 5 tours
            break

finally:
    lidar.stop()
    lidar.stop_motor()
    lidar.disconnect()
