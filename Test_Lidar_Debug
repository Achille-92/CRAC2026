import matplotlib.pyplot as plt
from rplidar import RPLidar
import numpy as np

PORT_NAME = '/dev/ttyUSB1'
BAUDRATE = 256000
MAX_BUFFER = 500

angles = []
distances = []

def run():
    global angles, distances
    lidar = RPLidar(PORT_NAME, baudrate=BAUDRATE)
    
    print("INFO:", lidar.get_info())
    print("HEALTH:", lidar.get_health())
    
    lidar.start_motor()

    # Mode interactif pour matplotlib
    plt.ion()
    fig, ax = plt.subplots(subplot_kw={'projection': 'polar'})
    ax.set_ylim(0, 6000)
    ax.set_title("RPLIDAR A2M12 - Scan en temps réel")
    points, = ax.plot([], [], 'bo', markersize=2)

    refresh_rate = 50  # rafraîchissement toutes les 50 mesures

    try:
        for i, (new_scan, quality, angle, distance) in enumerate(
            lidar.iter_measures(scan_type='express', max_buf_meas=MAX_BUFFER)
        ):
            # filtrer les mesures invalides
            if distance is not None and quality is not None and distance > 0 and quality > 0:
                angles.append(np.radians(angle))
                distances.append(distance)

            # rafraîchir moins souvent
            if i % refresh_rate == 0:
                points.set_data(angles, distances)
                plt.pause(0.01)

            # optionnel : reset à chaque nouveau tour
            if new_scan:
                angles, distances = [], []

    except KeyboardInterrupt:
        print("Arrêt demandé par l'utilisateur")

    except Exception as e:
        print("Erreur RPLidar :", e)

    finally:
        print("Arrêt du Lidar...")
        lidar.stop()
        lidar.stop_motor()
        lidar.disconnect()
        plt.close(fig)  # ferme proprement la fenêtre

if __name__ == '__main__':
    run()
