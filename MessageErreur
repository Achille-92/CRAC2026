python3 - <<'PY'
from rplidar import RPLidar
PORT = '/dev/ttyUSB0'
lidar = RPLidar(PORT, baudrate=115200)
try:
    for i, meas in enumerate(lidar.iter_measures()):
        print(i, meas)   # (new_scan, quality, angle, distance)
        if i >= 50:
            break
except Exception as e:
    print('ERREUR pendant iter_measures():', type(e).__name__, e)
finally:
    lidar.stop()
    lidar.disconnect()
PY
