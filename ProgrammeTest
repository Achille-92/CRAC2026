def calcul_ennemi(stop_event):
    global x_ennemi, y_ennemi, angle_ennemi

    buffer_points = deque(maxlen=500)
    x_prec, y_prec = None, None
    angle_ennemi = 0  # initialisation

    while not stop_event.is_set():
        try:
            # Récupère un point du Lidar
            p = pile_calcul.get(timeout=0.1)
            buffer_points.append(p)
        except queue.Empty:
            pass

        # Calcul barycentre
        if buffer_points:
            xs, ys = zip(*buffer_points)
            x_new = np.mean(xs)
            y_new = np.mean(ys)

            # Calcul direction si on a déjà un point précédent
            if x_prec is not None and y_prec is not None:
                dx = x_new - x_prec
                dy = y_new - y_prec
                if dx != 0 or dy != 0:  # éviter division par zéro
                    angle_ennemi = math.degrees(math.atan2(dy, dx))
                    if angle_ennemi < 0:
                        angle_ennemi += 360

            # Mise à jour coordonnées actuelles
            x_ennemi, y_ennemi = x_new, y_new
            x_prec, y_prec = x_new, y_new
