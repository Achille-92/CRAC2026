    finally:
        print("Programme terminé proprement.")
    
        if Reel :
            if Lidar_on:
                tache_lidar.join()
            tache_LectureCAN.join()
            etat_RPI = 2
            data_etat_RPI = struct.pack('<I',etat_RPI)
