void recalage(int type)
{
  switch (type)
  {
  case X:
    if (pos_act[0] > 1500)
    {
      teta_cons = 0;
    }
    else
    {
      teta_cons = PI;
    }
    break;
  case Y:
    teta_cons = -PI / 2.0;
    break;
  case bleu:
    if (calX == 0)
    {
      teta_cons = PI;
    }
    else
    {
      teta_cons = -PI / 2.0;
    }
    break;
  case jaune:
    if (calX == 0)
    {
      teta_cons = 0;
    }
    else
    {
      teta_cons = -PI / 2.0;
    }
    break;
  }
  if (type == X || type == Y)
  {
    switch (etape)
    {

    case 0:

      vang = position.angle(teta_cons, teta_act, 0);
      PWM_G = moteur.gauche(-vang, Vg, 0);
      PWM_D = moteur.droit(vang, Vd, 0);

      if (fabs(Vg) < 0.05 && fabs(Vd) < 0.05 && (fabs(limit_angle(teta_cons - teta_act)) < (PI / 10.0)))
        etape = 2, temp = millis();
      break;
    case 2:
      if (diff_dist_droit == 0 && diff_dist_gauche == 0 && (millis() - temp) > 1000)
      {
        if (type == X)
        {
          if (pos_act[0] > 1500)
          {
            teta_cons = 0;
            pos_act[0] = 2935;
          }
          else
          {
            teta_cons = PI;
            pos_act[0] = 65;
          }
        }
        else
        {
          teta_cons = -PI / 2.0;
          pos_act[1] = 1935;
        }
        off_teta_act = teta_cons - teta_act;
        verif_recalage = 1;
      }
      break;
    }
  }
  else
  {
    switch (etape)
    {

    case 0:

      vang = position.angle(teta_cons, teta_act, 0);
      PWM_G = moteur.gauche(-vang, Vg, 0);
      PWM_D = moteur.droit(vang, Vd, 0);

      if (fabs(Vg) < 0.05 && fabs(Vd) < 0.05 && (fabs(limit_angle(teta_cons - teta_act)) < (PI / 10.0)))
        etape = 2, temp = millis();
      break;
    case 2:
      if (diff_dist_droit == 0 && diff_dist_gauche == 0 && (millis() - temp) > 1500)
      {
        if (calX == 0)
        {
          if (type == bleu)
          {
            pos_act[0] = 2935;
            pos_act[1] = 1835;
            diff_dist_droit = 0;
             diff_dist_gauche = 0;
            encoder2.setCount(0);
            encoder.setCount(0);
            teta_recu = 180.0;
            calX = 1;
            etape = 3;
          }
          else
          {
            pos_act[0] = 65;
            pos_act[1] = 1835;
            diff_dist_droit = 0;
             diff_dist_gauche = 0;
            encoder2.setCount(0);
            encoder.setCount(0);
            teta_recu = 0;
            calX = 1;
            etape = 3;
          }
        }
        else if (calY == 0)
        {
          pos_act[1] = 1935;
          calY = 1;
          verif_recalage = 1;
          etape = 4;
        }
      }
      break;
    case 3:
      if (fabs(distance_droit) > 200)
      {
        etape = 0;
      }
      break;
    case 4:
      break;
    }
  }
}

void aquisition(void)
{
  tic_droit = encoder2.getCount();
  tic_gauche = encoder.getCount();

  tour_droit = (float)tic_droit / tic_tour_droit;
  tour_gauche = (float)tic_gauche / tic_tour_gauche;

  old_dist_droit = distance_droit;
  old_dist_gauche = distance_gauche;

  distance_droit = tour_droit * 40.0 * PI;
  distance_gauche = tour_gauche * 40.0 * PI;

  diff_dist_droit = distance_droit - old_dist_droit;
  diff_dist_gauche = distance_gauche - old_dist_gauche;

  Vg = diff_dist_gauche / 10.0;
  Vd = diff_dist_droit / 10.0;

  for (int i = 0; i <= 4; i++)
  {
    moy_vitD[i + 1] = moy_vitD[i];
    moy_vitG[i + 1] = moy_vitG[i];
  }
  moy_vitD[0] = Vd;
  moy_vitG[0] = Vg;

  Vd = (moy_vitD[0] + moy_vitD[1] + moy_vitD[2]) / 3.0;
  Vg = (moy_vitG[0] + moy_vitG[1] + moy_vitG[2]) / 3.0;
  delta_x = liste_point[0].x - pos_act[0];
  delta_y = liste_point[0].y - pos_act[1];

  teta = atan2(delta_y, delta_x);

  if (RPI == 1)
    teta_act = (teta_recu * PI / 180.0) + ((distance_droit - distance_gauche) / (20 * Rayon)) + off_teta_act;
  else
    teta_act = ((distance_droit - distance_gauche) / (20 * Rayon)) - PI / 2.0 + off_teta_act;

  dist = sqrt(((pos_fin[0] - pos_act[0]) * (pos_fin[0] - pos_act[0])) + ((pos_fin[1] - pos_act[1]) * (pos_fin[1] - pos_act[1])));

  pos_act[0] = pos_act[0] + (cos(teta_act) * ((diff_dist_droit + diff_dist_gauche) / 2.0));
  pos_act[1] = pos_act[1] + (sin(teta_act) * ((diff_dist_gauche + diff_dist_droit) / 2.0));
}

